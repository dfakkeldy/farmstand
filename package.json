{
  "name": "farmstand",
  "version": "0.1.0",
  "private": true,
  "description": "Reserve farmstand items online, pay cash at pickup.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply farmstand --local",
    "db:migrate:remote": "wrangler d1 migrations apply farmstand --remote",
    "seed:local": "wrangler d1 execute farmstand --local --file scripts/seed-dev.sql",
    "admin": "node scripts/admin.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
